{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "esnext", "moduleResolution": "bundler",
    "esModuleInterop": true, "isolatedModules": true, "strict": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"], "exclude": ["node_modules"]
}
