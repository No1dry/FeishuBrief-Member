# Production: the exact public Console HTTPS origin (no path).
NODE_ENV=production
MEMBER_ORIGIN=https://brief.example.org
MEMBER_HOST=127.0.0.1
MEMBER_PORT=5190
MEMBER_DATABASE_PATH=data/member.sqlite
# Generate two different random secrets; do not use example values.
MEMBER_SECRET=
MEMBER_MACHINE_TOKEN=
# Optional: absolute path to built Console dist; served at /app and /admin.
MEMBER_CONSOLE_DIR=

MEMBER_MAIL_MODE=smtp
MEMBER_SMTP_HOST=
MEMBER_SMTP_PORT=465
MEMBER_SMTP_SECURE=true
MEMBER_SMTP_FROM=
MEMBER_SMTP_USER=
MEMBER_SMTP_PASSWORD=

# Phase 6: personal credentials are independent of the existing group senders.
# Configure/bind first; enable these switches only for the intended pilot.
MEMBER_NOTIFICATION_WORKER_ENABLED=false
MEMBER_SCHEDULER_ENABLED=false
MEMBER_NOTIFICATION_POLL_MS=15000
# Configure all four Feishu fields together; require encrypted p2p message events.
MEMBER_FEISHU_APP_ID=
MEMBER_FEISHU_APP_SECRET=
MEMBER_FEISHU_ENCRYPT_KEY=
MEMBER_FEISHU_VERIFICATION_TOKEN=
# Persistent Open API secretKey; the short-lived accessKey refreshes automatically.
MEMBER_PUSHPLUS_TOKEN=
MEMBER_PUSHPLUS_SECRET_KEY=

# Local-only mode: NODE_ENV=development, MEMBER_ORIGIN=http://127.0.0.1:5180
# MEMBER_ALLOW_INSECURE_LOCAL=true
# MEMBER_MAIL_MODE=local
# MEMBER_LOCAL_MAIL_PATH=data/local-mail
# The local sink writes fake test emails privately; never expose that folder via HTTP.
