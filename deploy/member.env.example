# Copy to /etc/feishubrief/member.env, owned root:feishubrief with mode 0640.
# All paths below correspond to deploy/systemd/feishubrief-member.service.
NODE_ENV=production
MEMBER_ORIGIN=https://brief.example.org
MEMBER_HOST=127.0.0.1
MEMBER_PORT=5190
MEMBER_DATABASE_PATH=/var/lib/feishubrief/member.sqlite
MEMBER_CONSOLE_DIR=/opt/feishubrief/console/dist

# Generate two different random secrets. Empty values intentionally prevent startup.
MEMBER_SECRET=
MEMBER_MACHINE_TOKEN=

MEMBER_MAIL_MODE=smtp
MEMBER_SMTP_HOST=
MEMBER_SMTP_PORT=465
MEMBER_SMTP_SECURE=true
MEMBER_SMTP_FROM=
MEMBER_SMTP_USER=
MEMBER_SMTP_PASSWORD=

# Personal notification credentials; never reuse the group variables implicitly.
MEMBER_NOTIFICATION_WORKER_ENABLED=false
MEMBER_SCHEDULER_ENABLED=false
MEMBER_NOTIFICATION_POLL_MS=15000
MEMBER_FEISHU_APP_ID=
MEMBER_FEISHU_APP_SECRET=
MEMBER_FEISHU_ENCRYPT_KEY=
MEMBER_FEISHU_VERIFICATION_TOKEN=
MEMBER_PUSHPLUS_TOKEN=
MEMBER_PUSHPLUS_SECRET_KEY=
